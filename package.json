{
	"name": "vaporbooster",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate": "pnpm dlx @better-auth/cli generate --output ./src/lib/schema.ts --config ./src/lib/auth.ts",
		"migrate": "pnpm exec drizzle-kit push",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "deno run -A --env-file=.env ./.deno-deploy/server.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@deno/svelte-adapter": "^0.1.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.3",
		"vite": "^8.0.8",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.2",
		"@tailwindcss/vite": "^4.2.2",
		"better-auth": "^1.6.5",
		"drizzle-orm": "^0.45.2",
		"jwt-decode": "^4.0.0",
		"qrcode": "^1.5.4",
		"steam-session": "^1.9.4",
		"steam-totp": "^2.1.2",
		"steam-user": "^5.3.0",
		"tailwindcss": "^4.2.2"
	}
}
